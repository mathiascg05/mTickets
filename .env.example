NEXT_PUBLIC_INSTANT_APP_ID=
INSTANT_APP_ADMIN_TOKEN=

# Conciliación asistida con IA (Gemini). Opcional: sin GEMINI_API_KEY el botón
# "Conciliar con archivo del banco" no aparece y la conciliación CSV sigue igual.
# Usa una key de tier PAGO: en el tier gratis Google puede usar los datos
# (extractos y nombres de compradores) para mejorar sus productos.
GEMINI_API_KEY=
# Modelo Flash económico vigente (ai.google.dev/gemini-api/docs/models, 2026-09-18).
GEMINI_MODEL=gemini-3.5-flash-lite
# Máximo de análisis por concierto cada 24 h (se cuentan en auditLogs).
RECONCILE_AI_DAILY_LIMIT=20
