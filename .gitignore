# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# test artifacts
/playwright-report/
/test-results/

# design assets
/assets/

# generated legal PDFs (regenerable via `pnpm legal:pdf`)
/legal/

# Sentry Config File
.env.sentry-build-plugin

# Load test env + artefactos (no commitear secretos ni resultados)
.env.staging
.env.*.local
/load-tests/results/
/load-tests/.loadtest-ids.json
.env.local
